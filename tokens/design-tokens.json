{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "global": {
    "color": {
      "obsidian": {
        "950": { "value": "#07080B", "type": "color" },
        "900": { "value": "#0B0C10", "type": "color" },
        "850": { "value": "#111319", "type": "color" },
        "800": { "value": "#161922", "type": "color" },
        "700": { "value": "#1F2430", "type": "color" }
      },
      "gold": {
        "300": { "value": "#FCE592", "type": "color" },
        "400": { "value": "#F3CA65", "type": "color" },
        "500": { "value": "#C9A84C", "type": "color" },
        "600": { "value": "#9B7D2F", "type": "color" }
      },
      "emerald": {
        "400": { "value": "#34D399", "type": "color" },
        "500": { "value": "#10B981", "type": "color" },
        "600": { "value": "#059669", "type": "color" },
        "900": { "value": "#064E3B", "type": "color" }
      },
      "sapphire": {
        "400": { "value": "#60A5FA", "type": "color" },
        "500": { "value": "#3B82F6", "type": "color" },
        "600": { "value": "#2563EB", "type": "color" }
      },
      "purple": {
        "400": { "value": "#C084FC", "type": "color" },
        "500": { "value": "#A855F7", "type": "color" },
        "600": { "value": "#8B5CF6", "type": "color" }
      },
      "cyan": {
        "400": { "value": "#22D3EE", "type": "color" },
        "500": { "value": "#06B6D4", "type": "color" }
      },
      "rose": {
        "400": { "value": "#FB7185", "type": "color" },
        "500": { "value": "#F43F5E", "type": "color" },
        "600": { "value": "#E11D48", "type": "color" }
      },
      "neutral": {
        "0":   { "value": "#FFFFFF", "type": "color" },
        "50":  { "value": "#F8FAFC", "type": "color" },
        "100": { "value": "#F1F5F9", "type": "color" },
        "400": { "value": "#94A3B8", "type": "color" },
        "500": { "value": "#64748B", "type": "color" },
        "900": { "value": "#0F172A", "type": "color" }
      }
    },
    "fontFamily": {
      "display": { "value": "'Space Grotesk', -apple-system, sans-serif", "type": "fontFamily" },
      "body":    { "value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif", "type": "fontFamily" },
      "mono":    { "value": "'Space Mono', monospace", "type": "fontFamily" }
    },
    "borderRadius": {
      "none": { "value": "0px", "type": "borderRadius" },
      "xs":   { "value": "4px", "type": "borderRadius" },
      "sm":   { "value": "6px", "type": "borderRadius" },
      "md":   { "value": "10px", "type": "borderRadius" },
      "lg":   { "value": "14px", "type": "borderRadius" },
      "xl":   { "value": "18px", "type": "borderRadius" },
      "pill": { "value": "9999px", "type": "borderRadius" }
    }
  },
  "semantic": {
    "color": {
      "brand": {
        "primary": {
          "value": "{global.color.gold.500}",
          "$extensions": {
            "mode": {
              "aureus_default": "{global.color.gold.500}",
              "meridian_wealth": "{global.color.emerald.500}",
              "apex_bank": "{global.color.purple.600}"
            }
          }
        },
        "accent": {
          "value": "{global.color.gold.400}",
          "$extensions": {
            "mode": {
              "aureus_default": "{global.color.gold.400}",
              "meridian_wealth": "{global.color.sapphire.400}",
              "apex_bank": "{global.color.cyan.400}"
            }
          }
        }
      },
      "surface": {
        "main": {
          "value": "{global.color.obsidian.900}",
          "$extensions": {
            "mode": {
              "dark": "{global.color.obsidian.900}",
              "light": "{global.color.neutral.50}"
            }
          }
        },
        "card": {
          "value": "{global.color.obsidian.850}",
          "$extensions": {
            "mode": {
              "dark": "{global.color.obsidian.850}",
              "light": "{global.color.neutral.0}"
            }
          }
        }
      },
      "text": {
        "primary": {
          "value": "{global.color.neutral.0}",
          "$extensions": {
            "mode": {
              "dark": "{global.color.neutral.0}",
              "light": "{global.color.neutral.900}"
            }
          }
        },
        "muted": {
          "value": "{global.color.neutral.400}",
          "$extensions": {
            "mode": {
              "dark": "{global.color.neutral.400}",
              "light": "{global.color.neutral.500}"
            }
          }
        }
      },
      "state": {
        "success": { "value": "{global.color.emerald.500}" },
        "danger":  { "value": "{global.color.rose.500}" }
      }
    },
    "border": {
      "radius": {
        "button": {
          "value": "{global.borderRadius.pill}",
          "$extensions": {
            "mode": {
              "aureus_default": "{global.borderRadius.pill}",
              "meridian_wealth": "{global.borderRadius.md}",
              "apex_bank": "{global.borderRadius.lg}"
            }
          }
        },
        "card": {
          "value": "{global.borderRadius.xl}",
          "$extensions": {
            "mode": {
              "aureus_default": "{global.borderRadius.xl}",
              "meridian_wealth": "{global.borderRadius.md}",
              "apex_bank": "{global.borderRadius.lg}"
            }
          }
        },
        "input": { "value": "{global.borderRadius.md}" }
      }
    }
  }
}
